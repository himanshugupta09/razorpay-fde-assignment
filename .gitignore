# ==============================================================================
# VIRTUAL ENVIRONMENTS
# ==============================================================================
# Exclude the environment directories; they can be massive and are easily rebuilt.
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# PYTHON BYTE-CODE / CACHES
# ==============================================================================
# Compiled files automatically generated by Python execution
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# CONFIGURATIONS & ENVIRONMENT SECRETS
# ==============================================================================
# Never commit sensitive credentials, API keys, or database files to version control
.env
.env.*
db.sqlite3

# ==============================================================================
# DISTRIBUTION & PACKAGING
# ==============================================================================
# Artifacts generated during package compilation, building, or bundling
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# IDE & EDITOR SPECIFIC
# ==============================================================================
# User-specific configuration folders for common text editors and IDEs
.vscode/
.idea/
.ropeproject
.spyderproject
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==============================================================================
# OPERATING SYSTEM SPECIFIC
# ==============================================================================
# System-generated metadata files
.DS_Store
Thumbs.db
